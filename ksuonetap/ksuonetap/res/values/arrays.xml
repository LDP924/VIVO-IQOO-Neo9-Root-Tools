<?xml version="1.0" encoding="utf-8"?>
<!-- 终端通道下拉项。顺序必须与 core/Channel.kt 的 Channel.all() 一致:
     auto / ksu / temp / shell -->
<resources>
    <string-array name="term_channels">
        <item>@string/term_channel_auto</item>
        <item>@string/term_channel_ksu</item>
        <item>@string/term_channel_temp</item>
        <item>@string/term_channel_shell</item>
    </string-array>

    <!-- 快捷命令 (与 TerminalActivity.QUICK 一一对应)。
         注意: aapt2 要求字符串资源里的单引号转义为 \' (这是资源语法, 不是 shell 语法),
         最终值里没有反斜杠。 -->
    <string-array name="term_quick_commands">
        <item>id</item>
        <item>getprop ro.build.display.id</item>
        <item>getprop ro.vivo.os.version</item>
        <item>cat /proc/modules | grep -E \'kernelsu|unpatch|vrpatch\'</item>
        <item>/data/adb/ksud insmod /data/local/tmp/kernelsu-vivo.ko</item>
        <item>/data/adb/ksud insmod /data/local/tmp/vrpatch.ko</item>
        <item>echo 0 > /sys/fs/selinux/enforce; getenforce</item>
        <item>ls -la /data/adb 2>/dev/null | head -20</item>
        <item>ps -A -o PID,USER,NAME | grep -E \'exploit|ksud\'</item>
        <item>dmesg | tail -30</item>
    </string-array>
</resources>
