<?xml version="1.0" encoding="utf-8"?>
<!-- 顶部栏: 深色渐变 + 下缘大圆角 (LSPosed 风格的 hero 区)。
     渐变用 ksuTopbarBgAlt -> ksuTopbarBg, **不要**改用 ksuPrimary / ksuPrimaryDim ——
     深色模式下那两个是浅色值, 配上 topbar_fg 的浅字几乎看不见。顶栏的约束是:
     任何色板 + 任何深浅下都得是「深底 + 浅字」。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="?attr/ksuTopbarBgAlt"
        android:endColor="?attr/ksuTopbarBg"
        android:type="linear" />
    <corners
        android:bottomLeftRadius="28dp"
        android:bottomRightRadius="28dp" />
</shape>
