<?xml version="1.0" encoding="utf-8"?>
<!-- 唯一的容器布局: 横向分页 (SwipePager) + 固定底部 dock。
     四个页面 (page_home / page_log / page_settings / page_about) 是横向条的四个子 View,
     宽度由 SwipePager.onMeasure 统一拉成与容器等宽 —— 只有这样 scrollX 才与页序号对得上。
     四个 page 里有同名 id (topBar / tvLog / btnCopyLog ...): 无妨, 页面各自从
     **自己的根 View** 查 id (见 ui/page/Page.kt), 不会串页。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_window">

    <com.neoroot.ksuonetap.ui.SwipePager
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/pagerStrip"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <include layout="@layout/page_home" />

            <include layout="@layout/page_log" />

            <include layout="@layout/page_settings" />

            <include layout="@layout/page_about" />
        </LinearLayout>
    </com.neoroot.ksuonetap.ui.SwipePager>

    <include layout="@layout/view_dock" />
</LinearLayout>
