<?xml version="1.0" encoding="utf-8"?>
<!-- 中性色与状态色 (浅色值)。深色值在 values-night/colors.xml 覆盖。
     主题色不在这里 —— 走 ?attr/ksu* (见 attrs.xml / themes.xml), 由色板主题决定。
     布局只引用 @color / ?attr 名, 不写死色值。 -->
<resources>
    <color name="bg_window">#FFFDF7FF</color>
    <color name="bg_surface">#FFFEF7FF</color>
    <color name="bg_container">#FFF3EDF7</color>
    <color name="bg_log">#FFF7F2FA</color>

    <!-- 顶栏前景色: 浅色下顶栏是主题主色 (深底), 深色下是 #2B2930, 两种都是浅字 -->
    <color name="topbar_fg">#FFFFFFFF</color>

    <color name="text_primary">#FF1D1B20</color>
    <color name="text_secondary">#FF49454F</color>
    <color name="text_tertiary">#FF79747E</color>
    <color name="outline">#FFCAC4D0</color>
    <color name="divider">#FFE7E0EC</color>

    <color name="state_ok">#FF1B5E20</color>
    <color name="state_ok_bg">#FFC8E6C9</color>
    <color name="state_warn">#FF7A4F01</color>
    <color name="state_warn_bg">#FFFFE0B2</color>
    <color name="state_err">#FF8C1D18</color>
    <color name="state_err_bg">#FFF9DEDC</color>
    <color name="state_idle">#FF49454F</color>
    <color name="state_idle_bg">#FFE7E0EC</color>

    <color name="ripple">#33000000</color>

    <!-- 终端输入框底 / 悬浮胶囊底 (深浅各一套, 不跟色板) -->
    <color name="bg_input">#FFF7F2FA</color>
    <color name="pill_bg">#D91D1B20</color>
</resources>
