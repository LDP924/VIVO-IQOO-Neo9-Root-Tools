<?xml version="1.0" encoding="utf-8"?>
<!-- 主题定义 (浅色版)。
     结构与取值说明:
       - Theme.KSUOneTap            = 基础主题 + 默认色板 (靛紫); 非色板项都在这里
       - Theme.KSUOneTap.<色板>     = 只覆盖色板色 attr
     night 版在 values-night/themes.xml, 同名 style 整体生效, 所以每套都要写全 —
     色板项少, 两处各写一遍比引入中间层更直白。
     android:statusBarColor / ksuTopbarBg / ksuTopbarBgAlt 三者同色系, 直接写死色值
     (避免 style 内自引用): 顶栏渐变 = ksuTopbarBgAlt -> ksuTopbarBg。 -->
<resources>
    <style name="Theme.KSUOneTap" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg_window</item>
        <item name="android:navigationBarColor">@color/bg_window</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">#FF6750A4</item>
        <item name="android:colorAccent">#FF6750A4</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="ksuPrimary">#FF6750A4</item>
        <item name="ksuPrimaryDim">#FF4F378B</item>
        <item name="ksuOnPrimary">#FFFFFFFF</item>
        <item name="ksuPrimaryContainer">#FFEADDFF</item>
        <item name="ksuTopbarBg">#FF6750A4</item>
        <item name="ksuTopbarBgAlt">#FF4F378B</item>
        <item name="ksuTopbarMarkBg">#33FFFFFF</item>
    </style>

    <style name="Theme.KSUOneTap.Blue" parent="Theme.KSUOneTap">
        <item name="android:statusBarColor">#FF1B6FC4</item>
        <item name="android:colorAccent">#FF1B6FC4</item>
        <item name="ksuPrimary">#FF1B6FC4</item>
        <item name="ksuPrimaryDim">#FF0F4C8A</item>
        <item name="ksuOnPrimary">#FFFFFFFF</item>
        <item name="ksuPrimaryContainer">#FFD6E4FF</item>
        <item name="ksuTopbarBg">#FF1B6FC4</item>
        <item name="ksuTopbarBgAlt">#FF0F4C8A</item>
        <item name="ksuTopbarMarkBg">#33FFFFFF</item>
    </style>

    <style name="Theme.KSUOneTap.Teal" parent="Theme.KSUOneTap">
        <item name="android:statusBarColor">#FF00696D</item>
        <item name="android:colorAccent">#FF00696D</item>
        <item name="ksuPrimary">#FF00696D</item>
        <item name="ksuPrimaryDim">#FF004F52</item>
        <item name="ksuOnPrimary">#FFFFFFFF</item>
        <item name="ksuPrimaryContainer">#FFCCE8E9</item>
        <item name="ksuTopbarBg">#FF00696D</item>
        <item name="ksuTopbarBgAlt">#FF004F52</item>
        <item name="ksuTopbarMarkBg">#33FFFFFF</item>
    </style>

    <style name="Theme.KSUOneTap.Green" parent="Theme.KSUOneTap">
        <item name="android:statusBarColor">#FF3B6939</item>
        <item name="android:colorAccent">#FF3B6939</item>
        <item name="ksuPrimary">#FF3B6939</item>
        <item name="ksuPrimaryDim">#FF2A5028</item>
        <item name="ksuOnPrimary">#FFFFFFFF</item>
        <item name="ksuPrimaryContainer">#FFD7E8D3</item>
        <item name="ksuTopbarBg">#FF3B6939</item>
        <item name="ksuTopbarBgAlt">#FF2A5028</item>
        <item name="ksuTopbarMarkBg">#33FFFFFF</item>
    </style>

    <style name="Theme.KSUOneTap.Orange" parent="Theme.KSUOneTap">
        <item name="android:statusBarColor">#FF8B5000</item>
        <item name="android:colorAccent">#FF8B5000</item>
        <item name="ksuPrimary">#FF8B5000</item>
        <item name="ksuPrimaryDim">#FF6B3D00</item>
        <item name="ksuOnPrimary">#FFFFFFFF</item>
        <item name="ksuPrimaryContainer">#FFFFDDB8</item>
        <item name="ksuTopbarBg">#FF8B5000</item>
        <item name="ksuTopbarBgAlt">#FF6B3D00</item>
        <item name="ksuTopbarMarkBg">#33FFFFFF</item>
    </style>

    <style name="Theme.KSUOneTap.Red" parent="Theme.KSUOneTap">
        <item name="android:statusBarColor">#FFBA1A1A</item>
        <item name="android:colorAccent">#FFBA1A1A</item>
        <item name="ksuPrimary">#FFBA1A1A</item>
        <item name="ksuPrimaryDim">#FF93000A</item>
        <item name="ksuOnPrimary">#FFFFFFFF</item>
        <item name="ksuPrimaryContainer">#FFFFDAD6</item>
        <item name="ksuTopbarBg">#FFBA1A1A</item>
