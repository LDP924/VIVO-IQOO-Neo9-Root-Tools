diff --git a/kernel/hook/arm64/syscall_hook.c b/kernel/hook/arm64/syscall_hook.c
index 5f5b32c6..58f6d94b 100644
--- a/kernel/hook/arm64/syscall_hook.c
+++ b/kernel/hook/arm64/syscall_hook.c
@@ -129,7 +129,13 @@ static int __init ksu_find_ni_syscall_slots(int *out_slots, int max_slots)
     if (!ni_syscall)
         return 0;
 
-    for (i = 0; i < __NR_syscalls && count < max_slots; i++) {
+    /* Scan from the END of the table. On vivo 16.2.13.2 (5.15.197, CFI) the
+     * static sys_call_image holds __arm64_sys_ni_syscall.cfi_jt at slot 42
+     * (connect) -- the real handler is wired in later at boot -- so a
+     * head-first scan picks connect as a "free" slot and patching it kills
+     * every connect() on the system (network dead, observed 2026-10-03).
+     * The tail ni range is never repurposed by vendor code. */
+    for (i = __NR_syscalls - 1; i >= 0 && count < max_slots; i--) {
         if ((unsigned long)ksu_syscall_table[i] == ni_syscall) {
             out_slots[count++] = i;
             pr_info("ni_syscall %d: %d\n", count, i);
